APP_NAME=BetValue AI
ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://betvalue:betvalue@db:5432/betvalue
AUTO_CREATE_SCHEMA=false

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TIMEZONE=Europe/Moscow

JWT_SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Открытые источники данных о матчах (без реальных коэффициентов)
FOOTBALL_DATA_API_KEY=
API_SPORTS_KEY=
API_TENNIS_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
API_SPORTS_HOCKEY_BASE_URL=https://v1.hockey.api-sports.io
API_SPORTS_BASKETBALL_BASE_URL=https://v1.basketball.api-sports.io
STATSBOMB_OPEN_DATA=true

# Official MELBET/Digitain Affiliate Feed (credentials must stay outside Git).
MELBET_FEED_ENABLED=false
MELBET_FEED_BASE_URL=https://affiliatefeedapi.tst-digi.com
MELBET_FEED_CLIENT_ID=
MELBET_FEED_CLIENT_SECRET=
# Test tournament IDs supplied by the provider. The API accepts at most 10 per request.
MELBET_FEED_TOURNAMENT_IDS=4485,4634,11897,29595,29594,7392,17240,4241,4584,4529,4702,21077,2754,30051,15557
MELBET_FEED_STAKE_TYPE_IDS=1,2,3,26,37
MELBET_FEED_LANGUAGE_IDS=1,2
MELBET_FEED_PREMATCH_DAYS=14

# Betfair Exchange API — Delayed App Key (бесплатный, https://developer.betfair.com/en/get-started/)
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_SESSION_TOKEN=

MIN_EV_THRESHOLD=0.05
MAX_ODDS=6.0
MIN_HISTORICAL_MATCHES=1000
DEFAULT_KELLY_FRACTION=0.25

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_URL=
TELEGRAM_WEB_APP_URL=https://bvai.onrender.com/telegram
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=600
TELEGRAM_STARS_ENABLED=false
TELEGRAM_PRO_PRICE_STARS=0
TELEGRAM_PRO_DURATION_DAYS=30

# Affiliate module stays disabled until contract, domains and tracking format are approved.
AFFILIATE_ENABLED=false
AFFILIATE_PROVIDER=partner
AFFILIATE_BASE_URL=
AFFILIATE_ALLOWED_HOSTS=
AFFILIATE_PROMO_CODE=
AFFILIATE_PROMO_PARAM=promo_code
AFFILIATE_CLICK_ID_PARAM=click_id
AFFILIATE_SUB_PARAM_PREFIX=sub

RATE_LIMIT_PER_MINUTE=60
