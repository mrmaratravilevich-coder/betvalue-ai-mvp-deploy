APP_NAME=BetValue AI
ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://betvalue:betvalue@db:5432/betvalue
AUTO_CREATE_SCHEMA=false

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TIMEZONE=Europe/Moscow

JWT_SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Открытые источники данных о матчах (без реальных коэффициентов)
FOOTBALL_DATA_API_KEY=
API_SPORTS_KEY=
API_TENNIS_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
API_SPORTS_HOCKEY_BASE_URL=https://v1.hockey.api-sports.io
API_SPORTS_BASKETBALL_BASE_URL=https://v1.basketball.api-sports.io
STATSBOMB_OPEN_DATA=true

# Betfair Exchange API — Delayed App Key (бесплатный, https://developer.betfair.com/en/get-started/)
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_SESSION_TOKEN=

MIN_EV_THRESHOLD=0.05
MAX_ODDS=6.0
MIN_HISTORICAL_MATCHES=1000
DEFAULT_KELLY_FRACTION=0.25

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_URL=
TELEGRAM_WEB_APP_URL=https://bvai.onrender.com/telegram

# Affiliate module stays disabled until contract, domains and tracking format are approved.
AFFILIATE_ENABLED=false
AFFILIATE_PROVIDER=partner
AFFILIATE_BASE_URL=
AFFILIATE_ALLOWED_HOSTS=
AFFILIATE_PROMO_CODE=
AFFILIATE_PROMO_PARAM=promo_code
AFFILIATE_CLICK_ID_PARAM=click_id
AFFILIATE_SUB_PARAM_PREFIX=sub

RATE_LIMIT_PER_MINUTE=60
